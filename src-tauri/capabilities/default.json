{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the Glossy main window, the translation popup, the screenshot overlay and the subtitle line.",
  "windows": ["main", "popup", "ocr", "subtitle", "subtitle-area", "subtitle-edit"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-position",
    "core:window:allow-set-size",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-inner-size",
    "core:window:allow-scale-factor"
  ]
}
