{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Glossy",
  "version": "0.1.0",
  "identifier": "com.glossy.translator",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Glossy",
        "url": "index.html",
        "width": 760,
        "height": 660,
        "minWidth": 620,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "visible": false
      },
      {
        "label": "notice",
        "title": "Glossy",
        "url": "notice.html",
        "width": 340,
        "height": 104,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "shadow": false,
        "center": false
      },
      {
        "label": "popup",
        "title": "Glossy Popup",
        "url": "popup.html",
        "width": 384,
        "height": 120,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "shadow": false,
        "center": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
