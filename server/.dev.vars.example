# 本地开发用（`npx wrangler dev`）。复制成 .dev.vars 后填自己的值，
# 这个文件在 .gitignore 里，不会被提交。线上用 `wrangler secret put`。
#
# 三个上游都配了就都留着：大模型先试，失败了自动交回机器翻译；
# 客户端可以点名要用哪一个（`vendor`），点名的排到最前面，仍然带兜底。
# 至少配一个，否则 /v1/translate 会返回 not_configured。

# 大模型上游（OpenAI 兼容接口），翻译质量比机器翻译好，按量计费。
# LLM_API_KEY = "你的大模型密钥"
# 默认智谱；换 DeepSeek、Moonshot、通义、OpenAI 只要改地址和模型名。
# LLM_ENDPOINT = "https://open.bigmodel.cn/api/paas/v4/chat/completions"
# LLM_MODEL = "glm-4-flash"

# 有道智云上游，签名简单、按量计费（翻译渠道里的「有道翻译」走的也是它）。
# YOUDAO_APP_KEY = "你的应用 ID"
# YOUDAO_APP_SECRET = "你的应用密钥"
# 只在本地调试时用：把有道地址换成自己的假接口。
# YOUDAO_ENDPOINT = "http://127.0.0.1:8791/api"

# 百度翻译上游，认证版每月 100 万字符，够一个自用部署。
BAIDU_APP_ID = "202xxxxxxxxx"
BAIDU_KEY = "你在百度翻译开放平台拿到的密钥"
# 用来给 IP 做哈希，随便一串随机字符即可，避免明文存 IP。
IP_SALT = "换成一串随机字符"
# 汇率接口（客户端货币换算用），不需要密钥，线上不设就用下面这两个官方地址。
# 只在本地调试时用：把它们换成自己的假接口。
# RATES_ENDPOINT = "https://open.er-api.com/v6/latest/"
# RATES_FALLBACK_ENDPOINT = "https://api.frankfurter.app/latest?from="
# 只在本地调试时用：把百度地址换成自己的假接口。
# BAIDU_ENDPOINT = "http://127.0.0.1:8791/api/trans/vip/translate"
